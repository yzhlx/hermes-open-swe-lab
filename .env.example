# Hermes Open SWE Lab — example environment (PLACEHOLDERS ONLY)
# Copy to `.env` on the cloud control plane and fill real values there.
# `.env` is gitignored and must never be committed.

# --- OpenAI-compatible relay (OPT-IN) ---
# Leave OPEN_SWE_OPENAI_BASE_URL empty to preserve upstream Open SWE default.
OPEN_SWE_OPENAI_BASE_URL=
OPEN_SWE_OPENAI_API_KEY=
OPEN_SWE_OPENAI_MODEL=
# Set to "true" ONLY if the relay supports the Responses API; otherwise
# the adapter defaults to Chat Completions (recommended for most relays).
OPEN_SWE_OPENAI_USE_RESPONSES=false
# Set to "true" to forbid any cross-provider (e.g. Anthropic) fallback.
OPEN_SWE_DISABLE_CROSS_PROVIDER_FALLBACK=true

# --- Must stay false; the adapter refuses to silently route via Gateway ---
LANGSMITH_GATEWAY_ENABLED=false

# --- Sandbox (cloud control plane) ---
SANDBOX_TYPE=langsmith

# --- Concurrency (MVP-0 fixed) ---
OPEN_SWE_MAX_CONCURRENCY_CODING=1
OPEN_SWE_MAX_CONCURRENCY_REVIEWER=1
OPEN_SWE_MAX_CONCURRENCY_SANDBOX=1
