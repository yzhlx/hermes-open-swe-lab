# Hermes Open SWE Control Plane — systemd EnvironmentFile (NON-SECRET config)
#
# SECURITY: This file contains ONLY deployment configuration. It must NEVER
# contain secrets (API keys, relay keys, GitHub App PEM, webhook secret, raw
# worker token). Those live in /opt/hermes-open-swe-lab/.env (mode 600, owned
# by hermes-swe) and are read by the application from that restricted file.
#
# Copy this file to:
#   /opt/hermes-open-swe-lab/systemd/hermes-swe-control-plane.env
# and adjust paths if your install root differs. Keep it mode 640, owned by
# root:hermes-swe (or hermes-swe:hermes-swe).

# --- Install root & import path ---
HERMES_APP_HOME=/opt/hermes-open-swe-lab
PYTHONPATH=/opt/hermes-open-swe-lab

# --- Runtime data & logs (must be writable by the hermes-swe user) ---
HERMES_RUNTIME_DIR=/opt/hermes-open-swe-lab/runtime
HERMES_LOG_DIR=/opt/hermes-open-swe-lab/logs
HERMES_DB_PATH=/opt/hermes-open-swe-lab/runtime/events.db

# --- Listen: LOOPBACK ONLY ---
# The Control Plane binds 127.0.0.1. Public HTTPS is terminated by the reverse
# proxy (nginx). It must NEVER bind 0.0.0.0 or a public IP (the app refuses to
# start if it does).
HERMES_LISTEN_HOST=127.0.0.1
HERMES_LISTEN_PORT=8080

# --- Localhost test mode ---
# MUST be explicitly set to 1 to allow standalone local plaintext testing.
# Default 0 = production: external access is HTTPS-only via the reverse proxy.
HERMES_LOCALHOST_TEST=0

# --- TLS (terminated by the reverse proxy, not the app) ---
# The reverse proxy owns the certificate. Reference only; the app does not read
# these. Keep the private key at mode 600, owned by root:hermes-swe.
# HERMES_TLS_CERT=/opt/hermes-open-swe-lab/tls/fullchain.pem
# HERMES_TLS_KEY=/opt/hermes-open-swe-lab/tls/privkey.pem
